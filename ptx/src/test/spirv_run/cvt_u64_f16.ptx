.version 6.5
.target sm_30
.address_size 64

.visible .entry cvt_u64_f16(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .f16 	    temp1;
    .reg .f16 	    temp2;
    .reg .f16 	    temp3;
    .reg .u64 	    temp1_64;
    .reg .u64 	    temp2_64;
    .reg .u64 	    temp3_64;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    ld.b16          temp1, [in_addr];
    ld.b16          temp2, [in_addr+2];
    ld.b16          temp3, [in_addr+4];
    cvt.rzi.u64.f16 temp1_64, temp1;
    cvt.rzi.u64.f16 temp2_64, temp2;
    cvt.rzi.u64.f16 temp3_64, temp3;
    st.u64          [out_addr], temp1_64;
    st.u64          [out_addr+8], temp2_64;
    st.u64          [out_addr+16], temp3_64;
	ret;
}
