.version 6.5
.target sm_30
.address_size 64

.visible .entry rsqrt_ftz_f64_subnormal(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .f64 temp;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];
    ld.f64 temp, [in_addr];
    rsqrt.approx.ftz.f64 temp, temp;
    st.f64 [out_addr], temp;
    add.u64 in_addr, in_addr, 8;
    add.u64 out_addr, out_addr, 8;
    ld.f64 temp, [in_addr];
    rsqrt.approx.ftz.f64 temp, temp;
    st.f64 [out_addr], temp;
    ret;
}
