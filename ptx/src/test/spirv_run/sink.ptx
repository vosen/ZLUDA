.version 6.5
.target sm_30
.address_size 64

.visible .entry sink(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
	.reg .u64 	    out_addr;
	.reg .b64 	    temp;
	.reg .u32 	    lo;
	.reg .u32 	    hi;
	.reg .u32 	    z;

	ld.param.u64 	in_addr, [input];
	ld.param.u64 	out_addr, [output];

	ld.b64          temp, [in_addr];
	mov.b64         {_, _}, temp;
	mov.b64         {lo, _}, temp;
	mov.b64         {_, hi}, temp;
	ld.v4.u32       {_, _, z, _}, [in_addr];
	ld.v4.u32       {_, _, _, _}, [in_addr];
	st.u32          [out_addr], hi;
	st.u32          [out_addr+4], lo;
	st.u32          [out_addr+8], z;
	ret;
}
